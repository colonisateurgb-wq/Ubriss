# -----------------------------------------------------------------------------
# Copy this file to .env.local for local dev, and set the same keys in
# Netlify under Site configuration > Environment variables for production.
# -----------------------------------------------------------------------------

# Supabase (Auth + Postgres). Get these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Notch Pay (Mobile Money). Leave NOTCHPAY_MODE=mock to demo the app without
# real keys — payments simulate instantly via /mock-checkout.
NOTCHPAY_MODE=mock
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_SECRET_KEY=

# OpenAI. Leave OPENAI_MODE=mock to demo script generation with the built-in
# templates — no API key or cost required.
OPENAI_MODE=mock
OPENAI_API_KEY=
