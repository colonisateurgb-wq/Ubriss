"use client";

import { Suspense, useEffect, useState } from "react";
import { useRouter, useSearchParams } from "next/navigation";
import { Loader2 } from "lucide-react";
import { getSupabaseBrowserClient } from "@/lib/supabase/client";

function AuthCallbackContent() {
  const router = useRouter();
  const searchParams = useSearchParams();
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    const supabase = getSupabaseBrowserClient();
    const next = searchParams.get("next") ?? "/dashboard";

    if (!supabase) {
      router.replace(next);
      return;
    }

    // The Supabase browser client auto-parses the #access_token fragment
    // from the magic-link redirect (detectSessionInUrl is on by default).
    // getSession() waits for that to finish before we check the result.
    supabase.auth.getSession().then(({ data: { session } }) => {
      if (session) {
        router.replace(next);
      } else {
        setError("Le lien a expiré ou a déjà été utilisé. Retourne sur la page de connexion.");
      }
    });
  }, [router, searchParams]);

  return (
    <main className="flex min-h-screen flex-col items-center justify-center gap-3 bg-ink-950 px-5 text-center">
      {error ? (
        <>
          <p className="text-sm text-red-300">{error}</p>
          <a href="/login" className="text-sm text-signal underline">
            Retourner à la connexion
          </a>
        </>
      ) : (
        <>
          <Loader2 className="h-6 w-6 animate-spin text-signal" />
          <p className="text-sm text-mute">Connexion en cours...</p>
        </>
      )}
    </main>
  );
}

export default function AuthCallbackPage() {
  return (
    <Suspense fallback={null}>
      <AuthCallbackContent />
    </Suspense>
  );
}

